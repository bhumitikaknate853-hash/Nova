rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    // --- Validation Functions ---

    function isValidUser(data, userId) {
      return data.keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 200
        && (!('photoUrl' in data) || data.photoUrl is string)
        && hasValidTimestamp(data.createdAt)
        && hasValidTimestamp(data.updatedAt);
    }

    function isValidChatSession(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'title', 'agentId', 'lastMessage', 'messageCount', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.userId == userId
        && data.title is string && data.title.size() <= 200
        && data.agentId is string && data.agentId.size() <= 50
        && data.lastMessage is string && data.lastMessage.size() <= 2000
        && data.messageCount is int && data.messageCount >= 0
        && hasValidTimestamp(data.createdAt)
        && hasValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data, userId, sessionId) {
      return data.keys().hasOnly(['id', 'userId', 'sessionId', 'role', 'content', 'agentId', 'hasImage', 'imageUrl', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.userId == userId
        && data.sessionId == sessionId
        && data.role in ['user', 'model', 'system']
        && data.content is string && data.content.size() <= 50000
        && data.agentId is string && data.agentId.size() <= 50
        && data.hasImage is bool
        && (!('imageUrl' in data) || data.imageUrl is string)
        && hasValidTimestamp(data.createdAt);
    }

    function isValidMemory(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'key', 'value', 'category', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.userId == userId
        && data.key is string && data.key.size() > 0 && data.key.size() <= 200
        && data.value is string && data.value.size() <= 5000
        && data.category in ['preference', 'context', 'instruction', 'fact']
        && hasValidTimestamp(data.createdAt)
        && hasValidTimestamp(data.updatedAt);
    }

    function isValidCreation(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'prompt', 'aspectRatio', 'style', 'status', 'imageUrl', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.userId == userId
        && data.prompt is string && data.prompt.size() <= 2000
        && data.aspectRatio is string && data.aspectRatio.size() <= 20
        && data.style is string && data.style.size() <= 50
        && data.status in ['completed', 'generating', 'failed']
        && data.imageUrl is string
        && hasValidTimestamp(data.createdAt);
    }

    function isValidPreference(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'voiceName', 'speechSpeed', 'language', 'theme', 'systemInstruction', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.userId == userId
        && data.voiceName is string && data.voiceName.size() <= 50
        && (data.speechSpeed is float || data.speechSpeed is int) && data.speechSpeed >= 0.25 && data.speechSpeed <= 3.0
        && data.language is string && data.language.size() <= 20
        && data.theme is string && data.theme.size() <= 20
        && data.systemInstruction is string && data.systemInstruction.size() <= 5000
        && hasValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /chat_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatSession(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && isValidChatSession(request.resource.data, userId);
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidChatMessage(request.resource.data, userId, sessionId);
          allow update: if isOwner(userId)
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.sessionId == resource.data.sessionId
                        && request.resource.data.createdAt == resource.data.createdAt
                        && isValidChatMessage(request.resource.data, userId, sessionId);
          allow delete: if isOwner(userId);
        }
      }

      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMemory(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && isValidMemory(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /creations/{creationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCreation(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && isValidCreation(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /preferences/{preferenceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPreference(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && request.resource.data.userId == resource.data.userId
                      && isValidPreference(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
